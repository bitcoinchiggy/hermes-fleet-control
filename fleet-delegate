#!/usr/bin/env python3
"""Control-local Buzz delegation helper."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from fleet_control.runtime import reexec_managed_python

